
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id_categoria Int       @id @default(autoincrement())
  nome_categoria String  @unique
  descricao     String

  produtos Produto[]
}

model Produto {
  id          Int    @id @default(autoincrement())
  nome        String
  preco       Float
  descricao   String
  estoque     Int
  data_cadastro DateTime @default(now())
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id_categoria])
}

model Usuario {
  id_usuario Int    @id @default(autoincrement())
  nome       String
  email      String  @unique
  senha      String
  cpf        String  @unique
  telefone   String
  endereco   String
}