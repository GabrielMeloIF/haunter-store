generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  cpf       String   @unique 
  telefone  String
  endereco   String
  dataCriacao DateTime @default(now())
  tipo_usuario String
}

model Produto {
  id          Int       @id @default(autoincrement())
  nome        String
  descricao   String
  preco       Float
  estoque     Int
  imagemUrl   String?
  dataCriacao DateTime  @default(now())

  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id_categoria])
}

model Categoria {
  id_categoria   Int      @id @default(autoincrement())
  nome_categoria String
  descricao      String?

  produtos       Produto[]
}