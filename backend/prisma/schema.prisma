generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  cpf       String   @unique 
  telefone  String
  endereco   String
  dataCriacao DateTime @default(now())
  tipo_usuario String
}